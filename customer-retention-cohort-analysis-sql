-- SECTION 1: DROP EXISTING TABLES
DROP TABLE IF EXISTS cohort_orders;
DROP TABLE IF EXISTS cohort_customers;

-- SECTION 2: CREATE CUSTOMERS TABLE
CREATE TABLE cohort_customers (
    customer_id INT PRIMARY KEY,
    customer_name VARCHAR(50) NOT NULL,
    city VARCHAR(50),
    signup_date DATE
);

-- SECTION 3: CREATE ORDERS TABLE
CREATE TABLE cohort_orders (
    order_id INT PRIMARY KEY,
    customer_id INT REFERENCES cohort_customers(customer_id),
    order_date DATE NOT NULL,
    order_amount NUMERIC(10,2) NOT NULL,
    order_status VARCHAR(20) NOT NULL
        CHECK (order_status IN ('Completed', 'Cancelled'))
);

